MONGODB_URI=mongodb://127.0.0.1:27017/task-force
SESSION_SECRET=replace-with-a-long-random-secret
PORT=3000
# APP_ORIGIN=https://your-app.example
# SMTP_URL=smtp://user:password@smtp.example:587
# SMTP_FROM=Task Force <noreply@example.com>

# Garage/S3 comment attachments (existing bucket with read/write/delete permission).
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_BUCKET=task-force
S3_ACCESS_KEY_ID=your-garage-key-id
S3_SECRET_ACCESS_KEY=your-garage-secret
# Existing GARAGE_DEFAULT_BUCKET / GARAGE_DEFAULT_ACCESS_KEY / GARAGE_DEFAULT_SECRET_KEY are also supported.
# Stable browser-facing origin for attachment links (recommended behind a proxy).
PUBLIC_APP_URL=http://localhost:3031
